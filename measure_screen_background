#!/usr/bin/env python3

import argparse
import numpy as np
from pathlib import Path
from datetime import datetime
from uuid import uuid4 as uuid
from time import sleep
import pydoocs

parser = argparse.ArgumentParser(description="Measure emittance at EuXFEL T3")
parser.add_argument(
    "--experiment_name",
    "-e",
    type=str,
    required=True,
    help="Name of the experiment (used for data storage)",
)
parser.add_argument(
    "--data_path",
    "-d",
    type=str,
    default="data",
    help="Path to store the measurement data",
)
args = parser.parse_args()


def measure(experiment_name: str) -> dict[str, float]:
    sample_id = (
        "BACKGROUND_"
        # time stamp incl milliseconds
        + datetime.now().strftime("%Y-%m-%d-%H-%M-%S-%f")[:-3]
        + "-"
        + uuid().hex[:8]
    )
    screens = pydoocs.read("XFEL.DIAG/CAMERA/OTRC.2560.T3/IMAGE_EXT_ZMQ")

    path_raw = Path(args.data_path, experiment_name, "samples_raw", f"{sample_id}.npz")
    path_raw.parent.mkdir(parents=True, exist_ok=True)

    data = {
        "screens": screens,
    }

    np.savez(path_raw, **data)

    return data


# main
num_measurements = 40
for i in range(num_measurements):
    print(f"Measurement {i+1}/{num_measurements}")
    data = measure(args.experiment_name)
    sleep(0.333) # screen refresh rate
